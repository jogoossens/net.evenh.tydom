            "type": "number",
            "title": {
              "en": "Measured temperature",
              "nl": "Gemeten temperatuur"
            },
            "example": 18.5
          },
          {
            "name": "setpoint",
            "type": "number",
            "title": {
              "en": "Setpoint",
              "nl": "Setpoint"
            },
            "example": 20
          },
          {
            "name": "shortfall",
            "type": "number",
            "title": {
              "en": "Shortfall (°C)",
              "nl": "Tekort (°C)"
