{
  "name": {
    "en": "Smoke detector"
  },
  "class": "sensor",
  "capabilities": [
    "alarm_smoke",
    "alarm_battery"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "energy": {
    "batteries": [
      "OTHER"
    ]
  },
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "start"
    },
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "title": {
          "en": "Sign in with your Tydom app account"
        },
        "usernameLabel": {
          "en": "E-mail"
        },
        "usernamePlaceholder": {
          "en": "you@example.com"
        },
        "passwordLabel": {
          "en": "Password"
        },
        "passwordPlaceholder": {
          "en": "Tydom app password"
        }
      },
      "navigation": {
        "prev": "start",
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
